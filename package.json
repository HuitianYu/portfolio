{
  "name": "research-portfolio",
  "private": true,
  "scripts": {
    "build": "npm run sync:shared && npm run format:check && npm run check:shared && npm run check && hugo --minify --cleanDestinationDir",
    "build:styles": "node tools/build-styles.mjs",
    "check:styles": "node tools/build-styles.mjs --check",
    "format": "node tools/format.mjs",
    "format:check": "node tools/format.mjs --check",
    "sync:shared": "npm run build:styles && node tools/sync-shared.mjs",
    "check:shared": "npm run check:styles && node tools/sync-shared.mjs --check",
    "check": "node tools/check.mjs"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "prettier-plugin-go-template": "0.0.15"
  }
}
